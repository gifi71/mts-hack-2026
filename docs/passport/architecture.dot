digraph arch {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.6, pad=0.2, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, fillcolor="#f6f6f6", color="#1a1a1a"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#6b6b6b", fontcolor="#3a3a3a"];

  user [label="Пользователь\ncurl / браузер", shape=oval, fillcolor="#ffffff"];
  git  [label="GitHub\ngifi71/mts-hack-2026", shape=cylinder, fillcolor="#ffffff"];

  subgraph cluster_node {
    label="ВМ Ubuntu 24.04 · Kubernetes 1.36.5 (kubeadm, 1 нода) · containerd · Calico";
    style="rounded"; color="#1a1a1a"; fontsize=11;

    subgraph cluster_edge { label="envoy-gateway-system"; style="dashed"; color="#9a9a9a";
      envoy [label="Envoy proxy\nGateway \"edge\"\nNodePort 30080 / 30443", fillcolor="#ffffff", color="#e02826", penwidth=2];
      egc   [label="Envoy Gateway\n(контроллер)"];
    }
    subgraph cluster_demo { label="demo (PSA restricted, NetworkPolicy)"; style="dashed"; color="#9a9a9a";
      v1 [label="Angie v1 ×2", fillcolor="#ffffff"];
      v2 [label="Angie v2 ×1", fillcolor="#ffffff"];
    }
    subgraph cluster_mon { label="monitoring"; style="dashed"; color="#9a9a9a";
      prom    [label="Prometheus", fillcolor="#f6f6f6"];
      grafana [label="Grafana", fillcolor="#f6f6f6"];
    }
    subgraph cluster_log { label="logging"; style="dashed"; color="#9a9a9a";
      fluentd [label="Fluentd\nDaemonSet", fillcolor="#f6f6f6"];
      loki    [label="Loki", fillcolor="#f6f6f6"];
    }
    argo [label="Argo CD\napp of apps", fillcolor="#ffffff"];
    kyverno [label="Kyverno\n(admission)", fillcolor="#ffffff"];
    cp   [label="control plane, kubelet,\nnode-exporter, kube-state-metrics"];
    logs [label="/var/log/containers", shape=note, fillcolor="#ffffff"];
  }

  user -> envoy [label="HTTP / HTTPS", color="#e02826", fontcolor="#e02826", penwidth=1.6];
  egc -> envoy [style=dotted, label="xDS"];
  envoy -> v1 [label="HTTPRoute 90%"];
  envoy -> v2 [label="10%, X-Canary, /v2"];
  envoy -> grafana [label="HTTPS"];
  prom -> v1 [style=dashed, label="scrape"];
  prom -> envoy [style=dashed];
  prom -> cp [style=dashed];
  v1 -> logs [style=dotted]; v2 -> logs [style=dotted];
  logs -> fluentd; fluentd -> loki;
  grafana -> prom; grafana -> loki;
  git -> argo [label="sync"];
  kyverno -> fluentd [style=dashed, color="#e02826", fontcolor="#e02826", label="подпись cosign"];
}
