# {{ ansible_managed }}
# App of apps: renders gitops/apps (a Helm chart of Argo CD Applications).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: {{ argocd_namespace }}
spec:
  project: default
  source:
    repoURL: {{ argocd_repo_url }}
    targetRevision: {{ argocd_revision }}
    path: gitops/apps
    helm:
      valuesObject:
        repoURL: {{ argocd_repo_url }}
        targetRevision: {{ argocd_revision }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
