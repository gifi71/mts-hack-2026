# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ kubeadm_advertise_address }}
nodeRegistration:
  name: {{ kubeadm_node_name }}
  criSocket: unix:///run/containerd/containerd.sock
{% if kubeadm_untaint_control_plane %}
  taints: []
{% endif %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ kubeadm_kubernetes_version }}
clusterName: {{ kubeadm_cluster_name }}
networking:
  podSubnet: {{ kubeadm_pod_subnet }}
  serviceSubnet: {{ kubeadm_service_subnet }}
apiServer:
  certSANs:
    - {{ kubeadm_advertise_address }}
    - {{ kubeadm_node_name }}
{% for san in kubeadm_cert_sans %}
    - {{ san }}
{% endfor %}
# Metrics endpoints on the node address so Prometheus can scrape the control plane.
# controller-manager and scheduler still require authentication on these ports.
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
etcd:
  local:
    extraArgs:
      - name: listen-metrics-urls
        value: http://0.0.0.0:2381
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
resolvConf: {{ kubeadm_kubelet_resolv_conf }}
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
metricsBindAddress: 0.0.0.0:10249
