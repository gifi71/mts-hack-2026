# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ kubeadm_advertise_address }}
nodeRegistration:
  name: {{ kubeadm_node_name }}
  criSocket: unix:///run/containerd/containerd.sock
{% if kubeadm_untaint_control_plane %}
  taints: []
{% endif %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ kubeadm_kubernetes_version }}
clusterName: {{ kubeadm_cluster_name }}
networking:
  podSubnet: {{ kubeadm_pod_subnet }}
  serviceSubnet: {{ kubeadm_service_subnet }}
apiServer:
  certSANs:
    - {{ kubeadm_advertise_address }}
    - {{ kubeadm_node_name }}
{% for san in kubeadm_cert_sans %}
    - {{ san }}
{% endfor %}
  # CIS Kubernetes Benchmark 1.2.15-1.2.19, 1.2.30 (checked by kube-bench in CI).
  extraArgs:
    - name: profiling
      value: "false"
    - name: service-account-extend-token-expiration
      value: "false"
    - name: audit-policy-file
      value: {{ kubeadm_audit_policy_path }}
    - name: audit-log-path
      value: {{ kubeadm_audit_log_dir }}/audit.log
    - name: audit-log-maxage
      value: "30"
    - name: audit-log-maxbackup
      value: "10"
    - name: audit-log-maxsize
      value: "100"
  extraVolumes:
    - name: audit-policy
      hostPath: {{ kubeadm_audit_policy_path }}
      mountPath: {{ kubeadm_audit_policy_path }}
      readOnly: true
      pathType: File
    - name: audit-log
      hostPath: {{ kubeadm_audit_log_dir }}
      mountPath: {{ kubeadm_audit_log_dir }}
      pathType: DirectoryOrCreate
# Metrics endpoints on the node address so Prometheus can scrape the control plane.
# controller-manager and scheduler still require authentication on these ports.
# This is why CIS 1.3.7 and 1.4.2 (bind to 127.0.0.1) stay failed.
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
    - name: profiling
      value: "false"
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
    - name: profiling
      value: "false"
etcd:
  local:
    extraArgs:
      - name: listen-metrics-urls
        value: http://0.0.0.0:2381
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
resolvConf: {{ kubeadm_kubelet_resolv_conf }}
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
metricsBindAddress: 0.0.0.0:10249
