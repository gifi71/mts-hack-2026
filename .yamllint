extends: default

ignore: |
  gitops/platform/envoy-gateway/charts/
  gitops/apps/templates/
  .ansible/
  ansible/.ansible/
  .venv/
  .serena/
  .omc/
  .claude/
  .rendered/

# slo-rules.yaml is generated by Sloth (make slo, CI checks it matches the spec). Only its
# layout differs from ours: leading blank line, unindented lists, long PromQL lines.
# Every other rule still applies to it.
rules:
  line-length:
    max: 160
    ignore: gitops/platform/monitoring/manifests/slo-rules.yaml
  indentation:
    ignore: gitops/platform/monitoring/manifests/slo-rules.yaml
  empty-lines:
    ignore: gitops/platform/monitoring/manifests/slo-rules.yaml
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
