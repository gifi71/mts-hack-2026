#cloud-config
# Rendered by OpenTofu. Minimal bootstrap only: everything else is done by Ansible.
hostname: ${hostname}
manage_etc_hosts: true
ssh_pwauth: false

# "default" = the image's built-in user (ubuntu), passwordless sudo.
users:
  - default
ssh_authorized_keys:
  - ${ssh_public_key}

# Host key is generated by OpenTofu, so the client can pin it in known_hosts
# and keep StrictHostKeyChecking on when the VM is recreated.
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]   # already provided below, so nothing is regenerated
ssh_keys:
  ed25519_private: |
    ${indent(4, trimspace(host_key_private))}
  ed25519_public: ${trimspace(host_key_public)}

package_update: true
%{ if length(packages) > 0 ~}
packages:
%{ for p in packages ~}
  - ${p}
%{ endfor ~}
%{ endif ~}
%{ if contains(packages, "qemu-guest-agent") ~}
runcmd:
  - systemctl enable --now qemu-guest-agent
%{ endif ~}
